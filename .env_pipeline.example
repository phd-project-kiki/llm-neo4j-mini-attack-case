# Template for .env_pipeline. Copy it:  copy .env_pipeline.example .env_pipeline
# .env_pipeline is git-ignored; never commit real passwords.
#
# Configuration for the Phase 2 pipeline (FastAPI + LlamaIndex + Ollama + Neo4j Desktop).
# The Streamlit version keeps using .env; this file is only read by app.py.
#
# These are the defaults shown on the web page. You can change the connection
# there and test it; values entered on the page are kept in memory only.

# --- Neo4j Desktop ---
NEO4J_URI=neo4j://127.0.0.1:7687
NEO4J_USERNAME=neo4j
# Leave the password empty to type it on the web page, or put it here to pre-fill.
NEO4J_PASSWORD=
NEO4J_DATABASE=attackcase

# --- Ollama ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_LLM_MODEL=llama3.2
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_REQUEST_TIMEOUT=600
